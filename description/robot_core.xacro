<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"  name="robot">

<xacro:include filename="inertia_macro.xacro"/>

<material name="white">
    <color rgba = "1 1 1 1"/>
</material>

<material name="orange">
    <color rgba="1 0.3 0.1 1" />
</material>

<material name="blue">
    <color rgba="0.2 0.2 1 1" />
</material>

<material name ="black">
    <color rgba="0 0 0 1" />
</material>


<link name="base_link">
    
</link>



<joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis" />
    <origin xyz="-0.2 0 0.05"/>
</joint>


<link name="chassis">
<visual>
    <origin xyz="0.2 0 0.075" />
    <geometry>
        <box size ="0.4 0.4 0.15" />
    </geometry>
    <material name="white" />
</visual>
<collision>
    <origin xyz="0.2 0 0.075" />
    <geometry>
        <box size ="0.4 0.4 0.15" />
    </geometry>
</collision>
<xacro:inertial_box mass="0.5" x="0.4" y="0.4" z="0.15">
    <origin xyz="0.2 0 0.075" rpy="0 0 0"/>
</xacro:inertial_box> 

</link>

<gazebo reference = "chassis">
<visual><material>
    <ambient>1 1 1 1</ambient>
    <diffuse>1 1 1 1</diffuse>
    <specular>1 1 1 1</specular>
</material></visual>
</gazebo>


<joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.22 0.05"/>
    <axis xyz="0 1 0" />
</joint>


<link name="left_wheel">
<visual>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <geometry>
        <cylinder radius="0.05" length="0.04"/>
    </geometry>
    <material name="black"/>
</visual>
<collision>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <geometry>
        <cylinder radius="0.05" length="0.04"/>
    </geometry>
</collision>
<xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
</xacro:inertial_cylinder>
</link>

<gazebo reference="left_wheel">
<visual><material>
    <ambient>0 0 0 1</ambient>
    <diffuse>0 0 0 1</diffuse>
    <specular>0 0 0 1</specular>
</material></visual>
</gazebo>

<joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.22 0.05"/>
    <axis xyz="0 1 0" />
</joint>

<link name="right_wheel">
<visual>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <geometry>
        <cylinder radius="0.05" length="0.04" />
    </geometry>
    <material name="black"/>
</visual>
<collision>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <geometry>
        <cylinder radius="0.05" length="0.04" />
    </geometry>
</collision>
<xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
    <origin xyz="0 0 0" rpy="1.5708 0 0" />
</xacro:inertial_cylinder>
</link>

<gazebo reference="right_wheel">
<visual><material>
    <ambient>0 0 0 1</ambient>
    <diffuse>0 0 0 1</diffuse>
    <specular>0 0 0 1</specular>
</material></visual>
</gazebo>


<joint name ="caster_wheel_joint" type="fixed">
    <parent link="chassis"/>
    <child link="caster_wheel" />
    <origin xyz="0.25 0 0.045" />
</joint>

<link name="caster_wheel">
<visual> 
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
        <sphere radius="0.095"/>
    </geometry>
    <material name="black"/>
</visual>
<collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
        <sphere radius="0.095"/>
    </geometry>
</collision>
<xacro:inertial_sphere mass="0.1" radius="0.095">
    <origin xyz="0 0 0" rpy="0 0 0" />
</xacro:inertial_sphere> 
</link>

<gazebo reference="caster_wheel">
<visual><material>
    <ambient>0.2 0.2 1 1</ambient>
    <diffuse>0.2 0.2 1 1</diffuse>
    <specular>0.2 0.2 1 1</specular>
</material></visual>
<mu1 value="0.001"/>
<mu2 value="0.001"/>
</gazebo>

<joint name="dvl_joint" type="fixed">
    <parent link="chassis"/>
    <child link="dvl_link"/>
    <origin xyz="0.05 0 -0.01" rpy="0 0 0"/>
</joint>

<link name="dvl_link">
<visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
        <cylinder radius="0.03" length="0.03"/>
    </geometry>
    <material name="blue" />
</visual>
<collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
        <cylinder radius="0.03" length="0.03" />
    </geometry>
</collision>
</link>

<joint name="dvl_frame_joint" type="fixed">
    <parent link="dvl_link"/>
    <child link="dvl_frame"/>
    <origin xyz="0 0 0" rpy="0 3.14159 0"/>
</joint>

<link name="dvl_frame">
<visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
        <cylinder radius="0.03" length="0.015"/>
    </geometry>
    <material name="white"/>
</visual>
<collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
        <cylinder radius="0.03" length="0.015"/>
    </geometry>
</collision>
</link>
</robot>